# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shopbot?retryWrites=true&w=majority

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Security
JWT_SECRET=your-super-secure-jwt-secret-key-here
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# Platform Integration Secrets
SHOPIFY_APP_SECRET=your-shopify-app-secret-key
WOOCOMMERCE_WEBHOOK_SECRET=your-woocommerce-webhook-secret

# External Services (Optional)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@yourdomain.com

# Monitoring and Error Tracking (Optional)
SENTRY_DSN=your-sentry-dsn-url
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# SSL/TLS (Production only)
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/private.key

# Development/Testing
NODE_TLS_REJECT_UNAUTHORIZED=0
