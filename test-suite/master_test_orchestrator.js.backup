const IntelligentTestGenerator = require('./intelligent_test_generator');
const RootCauseAnalyzer = require('./root_cause_analyzer');
const QualityValidator = require('./quality_validator');
const IntelligentFixEngine = require('./intelligent_fix_engine');
const EnhancedReporting = require('./enhanced_reporting');
const fs = require('fs');
const path = require('path');
const { spawn } = require('child_process');

class MasterTestOrchestrator {
  constructor() {
    this.testGenerator = new IntelligentTestGenerator();
    this.rootCauseAnalyzer = new RootCauseAnalyzer();
    this.qualityValidator = new QualityValidator();
    this.fixEngine = new IntelligentFixEngine();
    this.reporter = new EnhancedReporting();
    
    this.config = {
      coverageTargets: { statements: 80, branches: 80, functions: 80, lines: 80 },
      passRateTarget: 99,
      qualityTarget: 80,
      maxIterations: 10,
      testTimeout: 900000
    };
  }

  async executeTransformation() {
    console.log('🚀 Starting Enhanced Test Suite Transformation');
    console.log(`📊 Targets: 80% coverage, 99% pass rate, 80% quality`);
    
    let iteration = 0;
    const transformationHistory = [];
    
    while (iteration < this.config.maxIterations) {
      iteration++;
      console.log(`\n🔄 === Enhanced Iteration ${iteration}/${this.config.maxIterations} ===`);
      
      try {
        // Phase 1: Context-aware test generation
        console.log('📝 Phase 1: Intelligent test generation...');
        const contextAnalysis = await this.analyzeProjectContext();
        const generatedTests = await this.generateIntelligentTests(contextAnalysis);
        
        // Phase 2: Execute test suite with monitoring
        console.log('🧪 Phase 2: Enhanced test execution...');
        const testResults = await this.executeTestSuiteWithMonitoring();
        
        // Phase 3: Advanced failure analysis
        console.log('🔍 Phase 3: Root cause analysis...');
        const failureAnalysis = await this.performAdvancedFailureAnalysis(testResults);
        
        // Phase 4: Coverage and quality analysis
        console.log('📊 Phase 4: Coverage and quality analysis...');
        const coverageData = await this.analyzeCoverageData();
        const qualityMetrics = await this.validateTestQuality(testResults, coverageData);
        
        // Phase 5: Intelligent fix application
        console.log('🔧 Phase 5: Applying intelligent fixes...');
        const appliedFixes = await this.applyIntelligentFixes(failureAnalysis);
        
        // Phase 6: Comprehensive reporting
        console.log('📈 Phase 6: Generating comprehensive report...');
        const report = await this.generateIterationReport(iteration, {
          contextAnalysis,
          generatedTests,
          testResults,
          failureAnalysis,
          coverageData,
          qualityMetrics,
          appliedFixes
        });
        
        transformationHistory.push(report);
        
        // Check if targets achieved
        const targetsAchieved = this.checkAllTargetsAchieved(coverageData, qualityMetrics, testResults);
        
        console.log(`✅ Iteration ${iteration} Summary:`);
        console.log(`   Coverage: ${Math.round(coverageData.total?.statements || 0)}%`);
        console.log(`   Pass Rate: ${Math.round(testResults.passRate || 0)}%`);
        console.log(`   Quality: ${Math.round(qualityMetrics.overall || 0)}%`);
        console.log(`   Fixes Applied: ${appliedFixes.length}`);
        
        if (targetsAchieved) {
          console.log('🎉 ALL TARGETS ACHIEVED! Proceeding to final verification...');
          break;
        }
        
        // Brief pause between iterations
        await this.pause(2000);
        
      } catch (error) {
        console.error(`❌ Error in iteration ${iteration}: ${error.message}`);
        console.error(error.stack);
      }
    }
    
    // Final verification phase
    console.log('\n🏁 Starting Final Verification...');
    await this.performFinalVerification(transformationHistory);
    
    console.log('✅ Enhanced Test Suite Transformation Complete!');
  }

  async analyzeProjectContext() {
    const context = {
      sourceFiles: [],
      testFiles: [],
      businessLogic: [],
      apiEndpoints: [],
      dataModels: [],
      dependencies: []
    };

    // Scan source directories
    const sourceDirs = ['src', 'lib', 'app', 'backend', 'apps'];
    for (const dir of sourceDirs) {
      const dirPath = path.join(process.cwd(), dir);
      if (fs.existsSync(dirPath)) {
        const files = await this.scanDirectory(dirPath, /\.js$/);
        for (const file of files) {
          const analysis = await this.testGenerator.analyzeCodeContext(file);
          context.sourceFiles.push({ path: file, analysis });
        }
      }
    }

    // Extract business logic patterns
    context.businessLogic = this.extractBusinessLogicPatterns(context.sourceFiles);
    
    // Identify API endpoints
    context.apiEndpoints = this.identifyAPIEndpoints(context.sourceFiles);
    
    // Extract data models
    context.dataModels = this.extractDataModels(context.sourceFiles);

    console.log(`📋 Context Analysis: ${context.sourceFiles.length} files, ${context.businessLogic.length} business functions`);
    return context;
  }

  async generateIntelligentTests(context) {
    const results = { generated: 0, enhanced: 0, files: [] };
    
    for (const sourceFile of context.sourceFiles.slice(0, 5)) { // Limit per iteration
      try {
        const tests = await this.testGenerator.generateIntelligentTests(sourceFile.analysis, sourceFile.path);
        
        if (tests.length > 0) {
          const testFilePath = this.generateTestFilePath(sourceFile.path);
          await this.writeTestFile(testFilePath, tests);
          
          results.generated += tests.length;
          results.files.push(testFilePath);
        }
      } catch (error) {
        console.error(`Error generating tests for ${sourceFile.path}: ${error.message}`);
      }
    }
    
    console.log(`✨ Generated ${results.generated} intelligent tests in ${results.files.length} files`);
    return results;
  }

  async executeTestSuiteWithMonitoring() {
    return new Promise((resolve) => {
      const startTime = Date.now();
      console.log('🏃 Executing test suite with coverage...');
      
      const testProcess = spawn('npm', ['test', '--', '--coverage', '--json'], {
        stdio: ['ignore', 'pipe', 'pipe'],
        shell: true
      });
      
      let stdout = '';
      let stderr = '';
      
      testProcess.stdout.on('data', (data) => {
        stdout += data.toString();
      });
      
      testProcess.stderr.on('data', (data) => {
        stderr += data.toString();
      });
      
      testProcess.on('close', (code) => {
        const duration = Date.now() - startTime;
        const results = this.parseTestResults(stdout, stderr, code, duration);
        
        console.log(`⏱️  Test execution completed in ${Math.round(duration/1000)}s`);
        console.log(`📊 Results: ${results.passed}/${results.total} passed (${Math.round(results.passRate)}%)`);
        
        resolve(results);
      });
      
      // Timeout handling
      setTimeout(() => {
        testProcess.kill('SIGTERM');
        resolve({ 
          success: false, 
          error: 'Test execution timeout',
          passRate: 0,
          total: 0,
          passed: 0,
          failed: 0
        });
      }, this.config.testTimeout);
    });
  }

  async performAdvancedFailureAnalysis(testResults) {
    if (!testResults.failures || testResults.failures.length === 0) {
      return { patterns: [], rootCauses: [], recommendations: [] };
    }
    
    const testOutput = testResults.output || '';
    const failingTests = testResults.failures || [];
    
    const analysis = await this.rootCauseAnalyzer.analyzeFailures(testOutput, failingTests);
    
    console.log(`🔍 Failure Analysis: ${analysis.patterns.length} patterns, ${analysis.rootCauses.length} root causes`);
    return analysis;
  }

  async analyzeCoverageData() {
    try {
      const coveragePath = path.join(process.cwd(), 'coverage', 'coverage-summary.json');
      
      if (fs.existsSync(coveragePath)) {
        const rawData = JSON.parse(fs.readFileSync(coveragePath, 'utf8'));
        return this.enhanceCoverageData(rawData);
      }
      
      // Fallback: parse from test output
      return this.parseCoverageFromOutput();
    } catch (error) {
      console.error(`Error analyzing coverage: ${error.message}`);
      return { total: { statements: 0, branches: 0, functions: 0, lines: 0 }, files: {} };
    }
  }

  async validateTestQuality(testResults, coverageData) {
    const qualityMetrics = await this.qualityValidator.validateTestQuality(testResults, coverageData);
    
    console.log(`🎯 Quality Metrics: Overall ${Math.round(qualityMetrics.overall)}%`);
    console.log(`   Coverage Quality: ${Math.round(qualityMetrics.coverageQuality)}%`);
    console.log(`   Assertion Quality: ${Math.round(qualityMetrics.assertionQuality)}%`);
    console.log(`   Test Completeness: ${Math.round(qualityMetrics.testCompleteness)}%`);
    
    return qualityMetrics;
  }

  async applyIntelligentFixes(failureAnalysis) {
    if (!failureAnalysis.rootCauses || failureAnalysis.rootCauses.length === 0) {
      return [];
    }
    
    const appliedFixes = await this.fixEngine.applyIntelligentFixes(failureAnalysis.rootCauses);
    
    console.log(`🔧 Applied ${appliedFixes.length} intelligent fixes`);
    appliedFixes.forEach(fix => {
      console.log(`   ✅ ${fix.description}`);
    });
    
    return appliedFixes;
  }

  async generateIterationReport(iteration, data) {
    const report = await this.reporter.generateComprehensiveReport(
      iteration,
      data.coverageData,
      data.qualityMetrics,
      data.testResults,
      data.appliedFixes
    );
    
    console.log(`📋 Report generated: Overall status ${report.summary.overallStatus}`);
    return report;
  }

  checkAllTargetsAchieved(coverageData, qualityMetrics, testResults) {
    const coverageAchieved = 
      (coverageData.total?.statements || 0) >= this.config.coverageTargets.statements &&
      (coverageData.total?.branches || 0) >= this.config.coverageTargets.branches &&
      (coverageData.total?.functions || 0) >= this.config.coverageTargets.functions &&
      (coverageData.total?.lines || 0) >= this.config.coverageTargets.lines;
    
    const passRateAchieved = (testResults.passRate || 0) >= this.config.passRateTarget;
    const qualityAchieved = (qualityMetrics.overall || 0) >= this.config.qualityTarget;
    
    return coverageAchieved && passRateAchieved && qualityAchieved;
  }

  async performFinalVerification(history) {
    console.log('🔍 Performing final verification with 5 test runs...');
    
    const verificationResults = [];
    
    for (let i = 1; i <= 5; i++) {
      console.log(`   Run ${i}/5...`);
      const result = await this.executeTestSuiteWithMonitoring();
      verificationResults.push(result);
      
      if (i < 5) await this.pause(3000); // Pause between runs
    }
    
    // Analyze consistency
    const consistency = this.analyzeVerificationConsistency(verificationResults);
    
    // Generate final comprehensive report
    await this.generateFinalReport(history, verificationResults, consistency);
    
    console.log('📊 Final verification complete!');
    console.log(`   Consistency: ${consistency.consistent ? '✅ Stable' : '❌ Unstable'}`);
    console.log(`   Average Pass Rate: ${Math.round(consistency.averagePassRate)}%`);
    console.log(`   Average Coverage: ${Math.round(consistency.averageCoverage)}%`);
  }

  analyzeVerificationConsistency(results) {
    const passRates = results.map(r => r.passRate || 0);
    const averagePassRate = passRates.reduce((sum, rate) => sum + rate, 0) / passRates.length;
    const passRateVariance = this.calculateVariance(passRates);
    
    return {
      consistent: passRateVariance < 5, // Less than 5% variance
      averagePassRate,
      passRateVariance,
      averageCoverage: 0, // Would calculate from coverage data
      runs: results.length
    };
  }

  async generateFinalReport(history, verificationResults, consistency) {
    const finalReport = {
      timestamp: new Date().toISOString(),
      transformationSummary: {
        totalIterations: history.length,
        finalStatus: this.determineFinalStatus(history, consistency),
        targetsAchieved: this.checkFinalTargets(history[history.length - 1]),
        transformationTime: this.calculateTransformationTime(history)
      },
      finalMetrics: this.extractFinalMetrics(history[history.length - 1]),
      verificationResults: {
        runs: verificationResults.length,
        consistency: consistency,
        reliability: this.calculateReliability(verificationResults)
      },
      transformationJourney: history.map(h => ({
        iteration: h.iteration,
        coverage: h.coverage.current,
        quality: h.testQuality.overall,
        passRate: h.testExecution.passRate,
        fixesApplied: h.fixes.applied
      })),
      recommendations: this.generateFinalRecommendations(history, consistency)
    };
    
    // Save comprehensive final report
    const reportPath = path.join(process.cwd(), 'final-transformation-report.json');
    fs.writeFileSync(reportPath, JSON.stringify(finalReport, null, 2));
    
    // Generate human-readable summary
    const summaryPath = path.join(process.cwd(), 'TRANSFORMATION_SUMMARY.md');
    const summary = this.generateTransformationSummary(finalReport);
    fs.writeFileSync(summaryPath, summary);
    
    console.log('📄 Final reports generated:');
    console.log(`   📊 ${reportPath}`);
    console.log(`   📝 ${summaryPath}`);
  }

  generateTransformationSummary(finalReport) {
    const metrics = finalReport.finalMetrics;
    const status = finalReport.transformationSummary.finalStatus;
    
    return `# Test Suite Transformation - Final Summary

## 🎯 Mission Status: ${status.toUpperCase()}

### Final Metrics
- **Coverage**: ${Math.round(metrics.coverage.statements)}% statements, ${Math.round(metrics.coverage.branches)}% branches
- **Pass Rate**: ${Math.round(metrics.passRate)}%
- **Quality Score**: ${Math.round(metrics.quality)}%

### Targets Achievement
- **80% Coverage**: ${metrics.coverage.statements >= 80 ? '✅' : '❌'} (${Math.round(metrics.coverage.statements)}%)
- **99% Pass Rate**: ${metrics.passRate >= 99 ? '✅' : '❌'} (${Math.round(metrics.passRate)}%)
- **80% Quality**: ${metrics.quality >= 80 ? '✅' : '❌'} (${Math.round(metrics.quality)}%)

### Transformation Journey
${finalReport.transformationJourney.map(j => 
  `- **Iteration ${j.iteration}**: Coverage ${Math.round(j.coverage.statements)}%, Pass Rate ${Math.round(j.passRate)}%, Quality ${Math.round(j.quality)}%`
).join('\n')}

### Verification Results
- **Test Runs**: ${finalReport.verificationResults.runs}
- **Consistency**: ${finalReport.verificationResults.consistency.consistent ? 'Stable ✅' : 'Unstable ❌'}
- **Reliability**: ${Math.round(finalReport.verificationResults.reliability)}%

---
*Transformation completed on ${finalReport.timestamp}*
*Total iterations: ${finalReport.transformationSummary.totalIterations}*
`;
  }

  // Utility methods
  async scanDirectory(dir, pattern) {
    const files = [];
    const items = fs.readdirSync(dir);
    
    for (const item of items) {
      const fullPath = path.join(dir, item);
      const stat = fs.statSync(fullPath);
      
      if (stat.isDirectory() && !item.startsWith('.') && item !== 'node_modules') {
        files.push(...await this.scanDirectory(fullPath, pattern));
      } else if (pattern.test(item)) {
        files.push(fullPath);
      }
    }
    
    return files;
  }

  generateTestFilePath(sourcePath) {
    const relativePath = path.relative(process.cwd(), sourcePath);
    const testPath = relativePath.replace(/\.js$/, '.test.js');
    return path.join(process.cwd(), 'tests', testPath);
  }

  async writeTestFile(testPath, tests) {
    const dir = path.dirname(testPath);
    if (!fs.existsSync(dir)) {
      fs.mkdirSync(dir, { recursive: true });
    }
    
    const testContent = tests.map(test => test.content).join('\n\n');
    const fullContent = `// Auto-generated intelligent tests\n// Generated on: ${new Date().toISOString()}\n\n${testContent}`;
    
    fs.writeFileSync(testPath, fullContent);
  }

  parseTestResults(stdout, stderr, code, duration) {
    // Parse Jest JSON output
    try {
      const lines = stdout.split('\n');
      let jsonLine = lines.find(line => line.startsWith('{') && line.includes('testResults'));
      
      if (jsonLine) {
        const results = JSON.parse(jsonLine);
        return {
          success: code === 0,
          total: results.numTotalTests || 0,
          passed: results.numPassedTests || 0,
          failed: results.numFailedTests || 0,
          passRate: results.numTotalTests > 0 ? (results.numPassedTests / results.numTotalTests) * 100 : 0,
          duration: duration,
          output: stdout + stderr,
          failures: this.extractFailures(results)
        };
      }
    } catch (error) {
      // Fallback parsing
    }
    
    return {
      success: code === 0,
      total: 0,
      passed: 0,
      failed: 0,
      passRate: 0,
      duration: duration,
      output: stdout + stderr,
      failures: []
    };
  }

  extractFailures(results) {
    const failures = [];
    
    if (results.testResults) {
      for (const testResult of results.testResults) {
        if (testResult.assertionResults) {
          for (const assertion of testResult.assertionResults) {
            if (assertion.status === 'failed') {
              failures.push(assertion.title);
            }
          }
        }
      }
    }
    
    return failures;
  }

  enhanceCoverageData(rawData) {
    return {
      total: rawData.total || { statements: 0, branches: 0, functions: 0, lines: 0 },
      files: rawData || {}
    };
  }

  parseCoverageFromOutput() {
    // Fallback coverage parsing
    return { total: { statements: 0, branches: 0, functions: 0, lines: 0 }, files: {} };
  }

  extractBusinessLogicPatterns(sourceFiles) {
    const patterns = [];
    // Extract business logic patterns from source files
    return patterns;
  }

  identifyAPIEndpoints(sourceFiles) {
    const endpoints = [];
    // Identify API endpoints from source files
    return endpoints;
  }

  extractDataModels(sourceFiles) {
    const models = [];
    // Extract data models from source files
    return models;
  }

  calculateVariance(values) {
    const mean = values.reduce((sum, val) => sum + val, 0) / values.length;
    const variance = values.reduce((sum, val) => sum + Math.pow(val - mean, 2), 0) / values.length;
    return Math.sqrt(variance);
  }

  determineFinalStatus(history, consistency) {
    const lastReport = history[history.length - 1];
    const targetsAchieved = lastReport.summary.targetsAchieved.all;
    
    if (targetsAchieved && consistency.consistent) return 'success';
    if (targetsAchieved && !consistency.consistent) return 'partial_success';
    return 'incomplete';
  }

  checkFinalTargets(lastReport) {
    return lastReport.summary.targetsAchieved;
  }

  calculateTransformationTime(history) {
    if (history.length < 2) return 0;
    const start = new Date(history[0].timestamp);
    const end = new Date(history[history.length - 1].timestamp);
    return end - start;
  }

  extractFinalMetrics(lastReport) {
    return {
      coverage: lastReport.coverage.current,
      quality: lastReport.testQuality.overall,
      passRate: lastReport.testExecution.passRate
    };
  }

  calculateReliability(results) {
    const passRates = results.map(r => r.passRate || 0);
    return passRates.reduce((sum, rate) => sum + rate, 0) / passRates.length;
  }

  generateFinalRecommendations(history, consistency) {
    const recommendations = [];
    
    if (!consistency.consistent) {
      recommendations.push({
        type: 'stability',
        priority: 'high',
        description: 'Improve test stability and consistency'
      });
    }
    
    return recommendations;
  }

  async pause(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }
}

// Export and run if called directly
module.exports = MasterTestOrchestrator;

if (require.main === module) {
  const orchestrator = new MasterTestOrchestrator();
  orchestrator.executeTransformation().catch(console.error);
}
