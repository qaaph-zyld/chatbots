/**
 * Cache Middleware
 * 
 * Express middleware for caching API responses with monitoring and warming
 */

// Import dependencies
const crypto = require('crypto');
const logger = require('../../utils/logger');
const { getConfig } = require('../../config/cache.config');
const { initMonitoring, recordHit, recordMiss } = require('./cache-monitor');
const { initWarming, trackAccess } = require('./cache-warmer');
const { calculateAdaptiveTTL, trackResourceAccess } = require('./adaptive-ttl');

/**
 * Dynamic cache prefix resolution
 * Prioritizes environment variables, then test context, then default
 * @returns {String} The appropriate cache prefix
 */
const getCachePrefix = () => {
  // Priority: Environment variable > Test context > Default
  if (process.env.CACHE_PREFIX) {
    return process.env.CACHE_PREFIX;
  }
  
  // Test environment detection
  if (process.env.NODE_ENV === 'test' || process.env.JEST_WORKER_ID) {
    return 'test';
  }
  
  return 'cache';
};

/**
 * Generate a cache key from request data
 * @param {Object} req - Express request object
 * @param {String|Object} prefixOrOptions - Cache key prefix or options object
 * @returns {String} - Cache key
 */
const generateCacheKey = (req, prefixOrOptions = '') => {
  // Create a string representation of the request
  const requestData = {
    path: req.path,
    body: req.body,
    params: req.params,
    query: req.query,
    user: req.user ? req.user._id : 'anonymous'
  };
  
  // Create a hash of the request data
  const hash = crypto
    .createHash('md5')
    .update(JSON.stringify(requestData))
    .digest('hex');
  
  // Determine prefix
  let prefix = prefixOrOptions;
  if (typeof prefixOrOptions === 'object' && prefixOrOptions !== null) {
    prefix = prefixOrOptions.prefix || getCachePrefix();
  }
  
  // Return the cache key with resolved prefix
  return `${prefix}:${hash}`;
};

/**
 * Create a caching middleware
 * @param {Object} redisClient - Redis client instance
 * @param {Object} options - Caching options
 * @returns {Function} - Express middleware function
 */
const createCacheMiddleware = (redisClient, options = {}) => {
  // Default options with dynamic prefix resolution
  const defaultOptions = {
    ttl: 3600, // Cache TTL in seconds (1 hour)
    prefix: getCachePrefix(), // Dynamic cache key prefix
    enabled: true, // Whether caching is enabled
    logHits: true, // Whether to log cache hits
    bypassHeader: 'X-Bypass-Cache', // Header to bypass cache
    bypassQuery: '_nocache', // Query parameter to bypass cache
    monitoring: false, // Whether to enable monitoring
    warming: false, // Whether to enable cache warming
    adaptiveTTL: false, // Whether to enable adaptive TTL
    cacheMethods: ['GET', 'POST'] // HTTP methods to cache
  };
  
  // Get config from cache.config.js - safely handle if not available
  let config = {};
  try {
    config = getConfig() || {};
  } catch (err) {
    logger.warn('Cache config not available, using defaults');
  }
  
  // Merge default options with config and provided options
  const mergedOptions = { 
    ...defaultOptions, 
    ...config,
    ...options
  };
  
  // Ensure prefix is properly resolved with priority - safely handle undefined
  mergedOptions.prefix = options.prefix || (config && config.prefix) || getCachePrefix();
  
  // Initialize monitoring and warming if enabled
  const monitor = mergedOptions.monitoring ? initMonitoring() : null;
  const warmer = mergedOptions.warming ? initWarming(redisClient) : null;
  
  // Return middleware function
  return async (req, res, next) => {
    try {
      // Critical: Early return for disabled caching
      if (!mergedOptions.enabled) {
        return next();
      }
      
      // Skip caching for non-cacheable HTTP methods
      if (!mergedOptions.cacheMethods.includes(req.method)) {
        return next();
      }
      
      // Skip caching if bypass header is present
      const bypassHeader = mergedOptions.bypassHeader.toLowerCase();
      if (req.headers[bypassHeader]) {
        return next();
      }
      
      // Skip caching if bypass query parameter is present
      if (req.query[mergedOptions.bypassQuery]) {
        return next();
      }
      
      // Generate cache key
      const cacheKey = generateCacheKey(req, mergedOptions.prefix);
      
      // Try to get cached response
      const cachedResponse = await redisClient.get(cacheKey).catch(err => {
        logger.error('Redis error when getting cached response', err);
        return null;
      });
      
      // If cached response exists, return it
      if (cachedResponse) {
        const { status, body } = JSON.parse(cachedResponse);
        
        // Log cache hit if enabled
        if (mergedOptions.logHits) {
          logger.debug(`Cache hit: ${cacheKey}`);
        }
        
        // Record cache hit if monitoring is enabled
        if (monitor) {
          recordHit(cacheKey);
        }
        
        // Return cached response
        return res.status(status).json(body);
      }
      
      // Record cache miss if monitoring is enabled
      if (monitor) {
        recordMiss(cacheKey);
      }
      
      // Track resource access for adaptive TTL if enabled
      if (mergedOptions.adaptiveTTL) {
        // Ensure this returns a Promise
        await Promise.resolve(trackResourceAccess(cacheKey, req.path));
      }
      
      // Track access for cache warming if enabled
      if (warmer) {
        // Ensure this returns a Promise
        await Promise.resolve(warmer.trackAccess(cacheKey, req.path));
      }
      
      // Cache miss, continue to next middleware
      // But first, override res.json to cache the response
      const originalJson = res.json;
      res.json = function(body) {
        // Only cache successful responses (2xx status codes)
        if (res.statusCode >= 200 && res.statusCode < 300) {
          // Determine TTL - use adaptive TTL if enabled
          let ttl = mergedOptions.ttl;
          if (mergedOptions.adaptiveTTL) {
            calculateAdaptiveTTL(cacheKey, req.path)
              .then(adaptiveTTL => {
                // Cache the response with adaptive TTL
                const responseToCache = JSON.stringify({
                  status: res.statusCode,
                  body
                });
                
                try {
                  if (typeof redisClient.setex === 'function') {
                    redisClient.setex(cacheKey, adaptiveTTL, responseToCache)
                      .catch(err => {
                        logger.error('Redis error when setting cached response with adaptive TTL', err);
                      });
                  } else {
                    // Handle mock or alternative implementation
                    redisClient.setex(cacheKey, adaptiveTTL, responseToCache);
                  }
                } catch (err) {
                  logger.error('Error caching response with adaptive TTL', err);
                }
              })
              .catch(err => {
                logger.error('Error calculating adaptive TTL', err);
                
                // Fallback to default TTL
                const responseToCache = JSON.stringify({
                  status: res.statusCode,
                  body
                });
                
                try {
                  if (typeof redisClient.setex === 'function') {
                    redisClient.setex(cacheKey, ttl, responseToCache)
                      .catch(err => {
                        logger.error('Redis error when setting cached response with default TTL', err);
                      });
                  } else {
                    // Handle mock or alternative implementation
                    redisClient.setex(cacheKey, ttl, responseToCache);
                  }
                } catch (err) {
                  logger.error('Error caching response with default TTL', err);
                }
              });
          } else {
            // Cache the response with default TTL
            const responseToCache = JSON.stringify({
              status: res.statusCode,
              body
            });
            
            try {
              if (typeof redisClient.setex === 'function') {
                redisClient.setex(cacheKey, ttl, responseToCache)
                  .catch(err => {
                    logger.error('Redis error when setting cached response', err);
                  });
              } else {
                // Handle mock or alternative implementation
                redisClient.setex(cacheKey, ttl, responseToCache);
              }
            } catch (err) {
              logger.error('Error caching response', err);
            }
          }
        }
        
        // Call the original res.json
        return originalJson.call(this, body);
      };
      
      return next();
    } catch (err) {
      logger.error('Error in cache middleware', err);
      return next();
    }
  };
};

/**
 * Clear cache entries matching a pattern
 * @param {Object} redisClient - Redis client instance
 * @param {String} pattern - Pattern to match cache keys
 * @returns {Promise<Number>} - Number of keys cleared
 */
const clearCache = async (redisClient, pattern = '*') => {
  // Get all keys matching the pattern
  const keys = await redisClient.keys(pattern);
  
  // If no keys found, return 0
  if (!keys || keys.length === 0) {
    return 0;
  }
  
  // Delete all keys
  const result = await redisClient.del(keys);
  
  // Return number of keys deleted
  return result;
};

// Export functions
module.exports = {
  generateCacheKey,
  createCacheMiddleware,
  clearCache,
  getCachePrefix
};
