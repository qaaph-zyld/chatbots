const fs = require('fs');
const path = require('path');

class QualityValidator {
  constructor() {
    this.qualityThresholds = {
      coverage: {
        statements: 80,
        branches: 80,
        functions: 80,
        lines: 80
      },
      assertions: {
        minPerTest: 2,
        meaningfulAssertions: 0.8
      },
      testCompleteness: {
        edgeCases: 0.7,
        errorHandling: 0.8,
        businessLogic: 0.9
      }
    };
  }

  async validateTestQuality(testResults, coverageData) {
    const validation = {
      overall: 0,
      coverageQuality: 0,
      assertionQuality: 0,
      testCompleteness: 0,
      edgeCaseCoverage: 0,
      recommendations: []
    };

    validation.coverageQuality = this.validateCoverageQuality(coverageData);
    validation.assertionQuality = this.validateAssertionQuality(testResults);
    validation.testCompleteness = this.validateTestCompleteness(testResults);
    validation.edgeCaseCoverage = this.validateEdgeCaseCoverage(testResults);

    validation.overall = (
      validation.coverageQuality * 0.3 +
      validation.assertionQuality * 0.25 +
      validation.testCompleteness * 0.25 +
      validation.edgeCaseCoverage * 0.2
    );

    validation.recommendations = this.generateQualityRecommendations(validation);

    return validation;
  }

  validateCoverageQuality(coverageData) {
    if (!coverageData || !coverageData.total) return 0;

    const { statements, branches, functions, lines } = coverageData.total;
    const thresholds = this.qualityThresholds.coverage;

    // Calculate weighted coverage quality
    const coverageScores = {
      statements: Math.min(statements / thresholds.statements, 1),
      branches: Math.min(branches / thresholds.branches, 1),
      functions: Math.min(functions / thresholds.functions, 1),
      lines: Math.min(lines / thresholds.lines, 1)
    };

    // Weight branches and functions more heavily as they indicate better test quality
    const weightedScore = (
      coverageScores.statements * 0.2 +
      coverageScores.branches * 0.35 +
      coverageScores.functions * 0.3 +
      coverageScores.lines * 0.15
    ) * 100;

    return Math.round(weightedScore);
  }

  validateAssertionQuality(testResults) {
    if (!testResults || !testResults.tests) return 0;

    let totalAssertions = 0;
    let meaningfulAssertions = 0;
    let testCount = 0;

    for (const test of testResults.tests) {
      testCount++;
      const assertions = this.countAssertions(test);
      totalAssertions += assertions.total;
      meaningfulAssertions += assertions.meaningful;
    }

    if (testCount === 0) return 0;

    const avgAssertionsPerTest = totalAssertions / testCount;
    const meaningfulRatio = meaningfulAssertions / totalAssertions;

    // Score based on assertion quantity and quality
    const quantityScore = Math.min(avgAssertionsPerTest / this.qualityThresholds.assertions.minPerTest, 1);
    const qualityScore = meaningfulRatio;

    return Math.round((quantityScore * 0.4 + qualityScore * 0.6) * 100);
  }

  countAssertions(test) {
    const assertionPatterns = [
      /expect\(/g,
      /assert\./g,
      /should\./g,
      /\.to\./g
    ];

    const meaningfulPatterns = [
      /toEqual\(/g,
      /toBe\(/g,
      /toMatchObject\(/g,
      /toHaveBeenCalledWith\(/g,
      /toThrow\(/g,
      /rejects\.toThrow\(/g,
      /resolves\.toEqual\(/g
    ];

    const trivialPatterns = [
      /toBeDefined\(\)/g,
      /toBeTruthy\(\)/g,
      /toBeFalsy\(\)/g
    ];

    let total = 0;
    let meaningful = 0;

    for (const pattern of assertionPatterns) {
      const matches = (test.content || '').match(pattern);
      if (matches) total += matches.length;
    }

    for (const pattern of meaningfulPatterns) {
      const matches = (test.content || '').match(pattern);
      if (matches) meaningful += matches.length;
    }

    for (const pattern of trivialPatterns) {
      const matches = (test.content || '').match(pattern);
      if (matches) meaningful -= matches.length * 0.5; // Penalty for trivial assertions
    }

    return {
      total: Math.max(total, 0),
      meaningful: Math.max(meaningful, 0)
    };
  }

  validateTestCompleteness(testResults) {
    if (!testResults || !testResults.tests) return 0;

    let edgeCaseTests = 0;
    let errorHandlingTests = 0;
    let businessLogicTests = 0;
    let totalTests = testResults.tests.length;

    for (const test of testResults.tests) {
      const content = test.content || '';
      
      if (this.hasEdgeCaseTesting(content)) edgeCaseTests++;
      if (this.hasErrorHandling(content)) errorHandlingTests++;
      if (this.hasBusinessLogicTesting(content)) businessLogicTests++;
    }

    if (totalTests === 0) return 0;

    const edgeCaseRatio = edgeCaseTests / totalTests;
    const errorHandlingRatio = errorHandlingTests / totalTests;
    const businessLogicRatio = businessLogicTests / totalTests;

    const thresholds = this.qualityThresholds.testCompleteness;

    const scores = {
      edgeCases: Math.min(edgeCaseRatio / thresholds.edgeCases, 1),
      errorHandling: Math.min(errorHandlingRatio / thresholds.errorHandling, 1),
      businessLogic: Math.min(businessLogicRatio / thresholds.businessLogic, 1)
    };

    return Math.round((scores.edgeCases * 0.3 + scores.errorHandling * 0.4 + scores.businessLogic * 0.3) * 100);
  }

  hasEdgeCaseTesting(content) {
    const edgeCasePatterns = [
      /edge case/i,
      /boundary/i,
      /empty/i,
      /null/i,
      /undefined/i,
      /zero/i,
      /maximum/i,
      /minimum/i,
      /invalid/i
    ];

    return edgeCasePatterns.some(pattern => pattern.test(content));
  }

  hasErrorHandling(content) {
    const errorPatterns = [
      /toThrow/,
      /rejects/,
      /catch/,
      /error/i,
      /exception/i,
      /fail/i
    ];

    return errorPatterns.some(pattern => pattern.test(content));
  }

  hasBusinessLogicTesting(content) {
    const businessLogicPatterns = [
      /calculate/i,
      /process/i,
      /validate/i,
      /transform/i,
      /authenticate/i,
      /authorize/i,
      /business/i,
      /logic/i
    ];

    return businessLogicPatterns.some(pattern => pattern.test(content));
  }

  validateEdgeCaseCoverage(testResults) {
    if (!testResults || !testResults.tests) return 0;

    let edgeCaseScore = 0;
    const totalTests = testResults.tests.length;

    for (const test of testResults.tests) {
      edgeCaseScore += this.calculateEdgeCaseScore(test);
    }

    return totalTests > 0 ? Math.round((edgeCaseScore / totalTests) * 100) : 0;
  }

  calculateEdgeCaseScore(test) {
    const content = test.content || '';
    let score = 0;

    // Check for different types of edge cases
    const edgeCaseTypes = {
      nullUndefined: /null|undefined/gi,
      emptyValues: /empty|""|''/gi,
      boundaryValues: /zero|maximum|minimum|MAX_VALUE|MIN_VALUE/gi,
      invalidInput: /invalid|malformed|corrupt/gi,
      extremeValues: /very long|huge|tiny|negative/gi
    };

    for (const [type, pattern] of Object.entries(edgeCaseTypes)) {
      const matches = content.match(pattern);
      if (matches) {
        score += Math.min(matches.length * 0.2, 1); // Cap contribution per type
      }
    }

    return Math.min(score, 1); // Cap total score at 1
  }

  generateQualityRecommendations(validation) {
    const recommendations = [];

    if (validation.coverageQuality < 80) {
      recommendations.push({
        type: 'coverage_improvement',
        priority: 'high',
        description: 'Improve code coverage, especially branch and function coverage',
        actions: [
          'Add tests for uncovered branches',
          'Test all exported functions',
          'Add integration tests for complex workflows'
        ]
      });
    }

    if (validation.assertionQuality < 70) {
      recommendations.push({
        type: 'assertion_improvement',
        priority: 'high',
        description: 'Improve assertion quality and meaningfulness',
        actions: [
          'Replace trivial assertions with meaningful ones',
          'Add more specific assertions (toEqual, toMatchObject)',
          'Increase assertions per test to validate behavior thoroughly'
        ]
      });
    }

    if (validation.testCompleteness < 70) {
      recommendations.push({
        type: 'completeness_improvement',
        priority: 'medium',
        description: 'Improve test completeness',
        actions: [
          'Add more error handling tests',
          'Include business logic validation',
          'Test edge cases and boundary conditions'
        ]
      });
    }

    if (validation.edgeCaseCoverage < 60) {
      recommendations.push({
        type: 'edge_case_improvement',
        priority: 'medium',
        description: 'Improve edge case coverage',
        actions: [
          'Test null and undefined inputs',
          'Test boundary values (min/max)',
          'Test invalid and malformed inputs',
          'Test extreme values and conditions'
        ]
      });
    }

    return recommendations;
  }

  async generateQualityReport(validation, coverageData, testResults) {
    const report = {
      timestamp: new Date().toISOString(),
      overall: validation.overall,
      metrics: {
        coverageQuality: validation.coverageQuality,
        assertionQuality: validation.assertionQuality,
        testCompleteness: validation.testCompleteness,
        edgeCaseCoverage: validation.edgeCaseCoverage
      },
      coverage: coverageData.total,
      testStats: {
        total: testResults.tests ? testResults.tests.length : 0,
        passed: testResults.passed || 0,
        failed: testResults.failed || 0,
        passRate: testResults.passRate || 0
      },
      recommendations: validation.recommendations,
      qualityTrend: await this.calculateQualityTrend()
    };

    // Save report
    const reportPath = path.join(process.cwd(), 'test-quality-report.json');
    fs.writeFileSync(reportPath, JSON.stringify(report, null, 2));

    return report;
  }

  async calculateQualityTrend() {
    // Load historical quality data and calculate trend
    const historyPath = path.join(process.cwd(), 'quality-history.json');
    
    if (!fs.existsSync(historyPath)) {
      return { trend: 'no_data', change: 0 };
    }

    try {
      const history = JSON.parse(fs.readFileSync(historyPath, 'utf8'));
      if (history.length < 2) {
        return { trend: 'insufficient_data', change: 0 };
      }

      const latest = history[history.length - 1];
      const previous = history[history.length - 2];
      const change = latest.overall - previous.overall;

      return {
        trend: change > 0 ? 'improving' : change < 0 ? 'declining' : 'stable',
        change: Math.round(change * 100) / 100
      };
    } catch (error) {
      return { trend: 'error', change: 0 };
    }
  }

  async saveQualityHistory(validation) {
    const historyPath = path.join(process.cwd(), 'quality-history.json');
    let history = [];

    if (fs.existsSync(historyPath)) {
      try {
        history = JSON.parse(fs.readFileSync(historyPath, 'utf8'));
      } catch (error) {
        // Start fresh if file is corrupted
        history = [];
      }
    }

    history.push({
      timestamp: new Date().toISOString(),
      overall: validation.overall,
      coverageQuality: validation.coverageQuality,
      assertionQuality: validation.assertionQuality,
      testCompleteness: validation.testCompleteness,
      edgeCaseCoverage: validation.edgeCaseCoverage
    });

    // Keep only last 50 entries
    if (history.length > 50) {
      history = history.slice(-50);
    }

    fs.writeFileSync(historyPath, JSON.stringify(history, null, 2));
  }
}

module.exports = QualityValidator;
