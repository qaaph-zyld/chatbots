{
  "name": "shopbot-mvp",
  "version": "1.0.0",
  "description": "E-commerce Customer Support Chatbot MVP",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrate": "node migrate.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "test:backend:unit": "cd apps/backend && npm test -- tests/api tests/models tests/auth",
    "test:backend:integration": "cd apps/backend && npm test -- tests/integration",
    "test:backend:security": "cd apps/backend && npm test -- tests/security",
    "test:backend:performance": "cd apps/backend && npm test -- tests/performance",
    "test:backend:coverage": "cd apps/backend && npm test -- --coverage",
    "test:frontend:unit": "cd apps/frontend && npm test -- --watchAll=false",
    "test:frontend:integration": "cd apps/frontend && npm test -- src/tests --watchAll=false",
    "test:frontend:a11y": "cd apps/frontend && npm run test:a11y",
    "test:frontend:performance": "cd apps/frontend && npm test -- tests/performance --watchAll=false",
    "test:frontend:coverage": "cd apps/frontend && npm test -- --coverage --watchAll=false",
    "test:e2e": "npm run test:e2e:run",
    "test:e2e:run": "echo 'E2E tests not yet implemented'",
    "test:smoke": "npm run test:backend:unit && npm run test:frontend:unit",
    "build:backend": "cd apps/backend && npm run build",
    "build:frontend": "cd apps/frontend && npm run build",
    "build:all": "npm run build:backend && npm run build:frontend",
    "start:backend": "cd apps/backend && npm start",
    "start:frontend": "cd apps/frontend && npm start",
    "start:dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "lint:security": "npm audit --audit-level=moderate",
    "security:deps": "npm audit --audit-level=high",
    "health:check:production": "curl -f $PRODUCTION_URL/health || exit 1",
    "deploy:rollback": "echo 'Rollback procedure not yet implemented'",
    "test:performance:benchmark": "cd apps/backend && npm test -- tests/performance --verbose",
    "monitor:web-vitals": "cd apps/frontend && npm run monitor:vitals",
    "report:performance": "echo 'Performance reporting not yet implemented'"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "critters": "^0.0.23",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "eslint": "^8.48.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^8.15.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "supertest": "^6.3.4"
  },
  "keywords": [
    "chatbot",
    "e-commerce",
    "customer-support",
    "shopify",
    "woocommerce",
    "automation"
  ],
  "author": "ShopBot Team",
  "license": "MIT"
}
