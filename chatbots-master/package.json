{
  "name": "customizable-chatbots",
  "version": "0.1.0",
  "description": "A modern, flexible platform for creating and deploying customizable chatbots with advanced AI capabilities",
  "main": "src/index.js",
  "_moduleAliases": {
    "@src": "./src",
    "@core": "./src/core",
    "@api": "./src/api",
    "@models": "./src/core/models",
    "@services": "./src/core/services",
    "@integrations": "./src/integrations",
    "@tests": "./src/tests",
    "@utils": "./src/utils"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "cross-env NODE_ENV=development nodemon --exec babel-node src/index.js",
    "build": "npm run clean && npm run compile",
    "clean": "rimraf dist/",
    "compile": "babel src --out-dir dist --extensions \".js,.jsx,.ts,.tsx\" --source-maps inline --copy-files",
    "type-check": "tsc --noEmit",
    "type-check:watch": "npm run type-check -- --watch",
    "lint": "eslint 'src/**/*.{js,ts,jsx,tsx}'",
    "lint:fix": "eslint 'src/**/*.{js,ts,jsx,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{js,ts,jsx,tsx,json,md}'",
    "format:check": "prettier --check 'src/**/*.{js,ts,jsx,tsx,json,md}'",
    "validate": "npm run lint && npm run type-check && npm run format:check",
    "test": "cross-env NODE_ENV=test jest --passWithNoTests",
    "test:watch": "npm test -- --watch",
    "test:watch:all": "jest --watchAll",
    "test:coverage": "npm test -- --coverage",
    "test:coverage:html": "jest --coverage --coverageReporters=html",
    "test:coverage:ci": "jest --coverage --coverageReporters=text-lcov | coveralls",
    "test:unit": "jest --testPathPattern='src/tests/unit' --passWithNoTests",
    "test:unit:watch": "npm run test:unit -- --watch",
    "test:unit:coverage": "npm run test:unit -- --coverage",
    "test:integration": "jest --config=jest.integration.config.js --passWithNoTests",
    "test:integration:watch": "npm run test:integration -- --watch",
    "test:integration:coverage": "npm run test:integration -- --coverage",
    "test:e2e": "jest --config=jest.e2e.config.js --passWithNoTests",
    "test:e2e:watch": "npm run test:e2e -- --watch",
    "test:e2e:ci": "start-server-and-test start http-get://localhost:3000/health 'npm run test:e2e'",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "npm run test:unit:coverage && npm run test:integration && npm run test:e2e:ci",
    "audit": "npm audit --production",
    "audit:fix": "npm audit fix",
    "security:check": "npm audit && snyk test",
    "security:monitor": "snyk monitor",
    "security:fix": "npm audit fix && snyk wizard",
    "docker:build": "docker build -t $npm_package_name:$npm_package_version .",
    "docker:run": "docker run -p 3000:3000 $npm_package_name:$npm_package_version",
    "docker:compose:up": "docker-compose -f docker-compose.yml up -d",
    "docker:compose:down": "docker-compose -f docker-compose.yml down",
    "docker:compose:logs": "docker-compose -f docker-compose.yml logs -f",
    "prepare": "husky install",
    "precommit": "lint-staged",
    "prepush": "npm run test:all",
    "prettier": "prettier --write '**/*.{js,ts,json,md}'",
    "pretty-quick": "pretty-quick --staged",
    "validate-branch": "node scripts/validate-branch-name.js",
    "deploy:staging": "node scripts/deploy-staging.js",
    "deploy:production": "node scripts/deploy-production.js",
    "deploy:rollback": "node scripts/rollback-deployment.js",
    "deploy:status": "node scripts/deployment-status.js",
    "deploy:verify": "node scripts/verify-deployment.js",
    "deploy:cleanup": "node scripts/cleanup-old-deployments.js",
    "docs": "typedoc --out docs/api src",
    "docs:serve": "npx serve docs/api",
    "changelog": "auto-changelog --package --template keepachangelog --commit-limit false --unreleased --tag-pattern \"v[0-9]*\" --issue-url-format https://github.com/your-org/your-repo/issues/{{id}}",
    "changelog:update": "npm run changelog && git add CHANGELOG.md",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "prestart:prod": "npm run build",
    "postinstall": "npm run build",
    "preversion": "npm test",
    "version": "npm run changelog:update && git add CHANGELOG.md",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pavleee23/chatbots.git"
  },
  "keywords": [
    "chatbot",
    "ai",
    "nlp",
    "conversational-ai",
    "customizable"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Pavleee23/chatbots/issues"
  },
  "homepage": "https://github.com/Pavleee23/chatbots#readme",
  "dependencies": {
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "marked": "^15.0.12",
    "morgan": "^1.10.0",
    "redis": "^5.5.6",
    "sentiment": "^5.0.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.6",
    "strip-ansi": "^6.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/node": "^7.28.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-runtime": "^7.27.3",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/runtime": "^7.27.3",
    "@playwright/test": "^1.40.1",
    "@types/jest": "^29.5.11",
    "adm-zip": "^0.5.16",
    "artillery": "^2.0.0",
    "aws-sdk": "^2.1520.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "body-parser": "^2.2.0",
    "chai": "^5.2.0",
    "clean-webpack-plugin": "^4.0.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "cypress": "^13.6.1",
    "dotenv": "^16.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-node": "^11.1.0",
    "express": "^5.1.0",
    "file-loader": "^6.2.0",
    "helmet": "^8.1.0",
    "html-webpack-plugin": "^5.6.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-mock-extended": "^3.0.5",
    "lint-staged": "^16.1.0",
    "mini-css-extract-plugin": "^2.9.2",
    "module-alias": "^2.2.3",
    "mongodb-memory-server": "^9.5.0",
    "mongoose": "^8.15.1",
    "multer": "^2.0.0",
    "nock": "^13.4.0",
    "nodemon": "^3.0.2",
    "playwright": "^1.52.0",
    "prettier": "^3.5.3",
    "sinon": "^17.0.1",
    "style-loader": "^4.0.0",
    "supertest": "^6.3.4",
    "terser-webpack-plugin": "^5.3.14",
    "ts-jest": "^29.1.1",
    "webpack": "^5.99.9",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2",
    "winston": "^3.17.0"
  }
}
