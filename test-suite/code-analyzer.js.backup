const fs = require('fs');
const path = require('path');

class CodeAnalyzer {
  constructor() {
    this.businessFunctions = [];
    this.extractMethods = this.extractMethods.bind(this);
  }

  analyzeFile(filePath) {
    try {
      if (!fs.existsSync(filePath)) {
        return { success: false, error: 'File not found' };
      }

      const code = fs.readFileSync(filePath, 'utf8');
      
      const fileAnalysis = {
        filePath,
        functions: [],
        businessLogic: false,
        error: null
      };

      // Simple regex-based analysis (more reliable than AST parsing)
      this.extractFunctionsFromCode(code, fileAnalysis);
      this.detectBusinessLogic(code, fileAnalysis);

      return { success: true, data: fileAnalysis };
    } catch (error) {
      return { 
        success: false, 
        error: `Error analyzing ${filePath}: ${error.message}` 
      };
    }
  }

  extractFunctionsFromCode(code, analysis) {
    // Function declarations
    const functionDeclarations = code.match(/function\s+([a-zA-Z_$][a-zA-Z0-9_$]*)\s*\(/g);
    if (functionDeclarations) {
      functionDeclarations.forEach(match => {
        const name = match.match(/function\s+([a-zA-Z_$][a-zA-Z0-9_$]*)/)[1];
        analysis.functions.push({
          name: name,
          type: 'function',
          isAsync: code.includes(`async function ${name}`),
          isGenerator: code.includes(`function* ${name}`)
        });
      });
    }

    // Arrow functions
    const arrowFunctions = code.match(/([a-zA-Z_$][a-zA-Z0-9_$]*)\s*=\s*(?:async\s*)?\([^)]*\)\s*=>/g);
    if (arrowFunctions) {
      arrowFunctions.forEach(match => {
        const name = match.match(/([a-zA-Z_$][a-zA-Z0-9_$]*)\s*=/)[1];
        analysis.functions.push({
          name: name,
          type: 'arrow-function',
          isAsync: match.includes('async'),
          isGenerator: false
        });
      });
    }

    // Method definitions
    const methods = code.match(/([a-zA-Z_$][a-zA-Z0-9_$]*)\s*\([^)]*\)\s*{/g);
    if (methods) {
      methods.forEach(match => {
        const name = match.match(/([a-zA-Z_$][a-zA-Z0-9_$]*)\s*\(/)[1];
        if (!analysis.functions.find(f => f.name === name)) {
          analysis.functions.push({
            name: name,
            type: 'method',
            isAsync: code.includes(`async ${name}`),
            isGenerator: false
          });
        }
      });
    }

    // Express route handlers
    const routes = code.match(/(app|router)\.(get|post|put|delete|patch)\s*\(/g);
    if (routes) {
      routes.forEach((match, index) => {
        const method = match.match(/\.(get|post|put|delete|patch)/)[1];
        analysis.functions.push({
          name: `${method}Route${index}`,
          type: 'route-handler',
          isAsync: true,
          isGenerator: false
        });
      });
    }
  }

  detectBusinessLogic(code, analysis) {
    const businessPatterns = [
      // Database operations
      /\.(find|findOne|save|create|update|delete|aggregate|insert|updateOne|deleteOne)/,
      // HTTP operations
      /\.(get|post|put|delete|patch)\s*\(/,
      // Authentication
      /(authenticate|authorize|login|logout|verify|jwt|token)/i,
      // Business domain terms
      /(calculate|process|validate|transform|encrypt|decrypt)/i,
      // Database models
      /(Schema|Model|mongoose|sequelize)/,
      // API patterns
      /(req\.|res\.|next\(|middleware)/
    ];

    analysis.businessLogic = businessPatterns.some(pattern => pattern.test(code));
  }

  extractMethods(filePath) {
    const result = this.analyzeFile(filePath);
    if (!result.success) {
      return { functions: [], businessLogic: false, error: result.error };
    }
    
    return {
      functions: result.data.functions,
      businessLogic: result.data.businessLogic,
      error: null
    };
  }

  isBusinessLogic(filePath) {
    const result = this.analyzeFile(filePath);
    if (!result.success) {
      return false;
    }
    
    return result.data.businessLogic;
  }

  generateTestableElements(filePath) {
    const analysis = this.extractMethods(filePath);
    if (analysis.error) {
      return [];
    }

    return analysis.functions.map(func => ({
      name: func.name,
      type: func.type,
      testType: this.determineTestType(func, analysis.businessLogic),
      priority: this.calculatePriority(func, analysis.businessLogic)
    }));
  }

  determineTestType(func, hasBusinessLogic) {
    if (func.type === 'route-handler') return 'integration';
    if (hasBusinessLogic) return 'business-logic';
    return 'unit';
  }

  calculatePriority(func, hasBusinessLogic) {
    if (func.type === 'route-handler') return 'high';
    if (hasBusinessLogic) return 'high';
    if (func.isAsync) return 'medium';
    return 'low';
  }
}

module.exports = CodeAnalyzer;
